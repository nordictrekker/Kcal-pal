# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# USDA FoodData Central (micronutrient enrichment). Free key:
# https://fdc.nal.usda.gov/api-key-signup.html — leave blank to keep AI-only micros.
USDA_FDC_API_KEY=

# Oura
OURA_PERSONAL_ACCESS_TOKEN=

# Auth allowlist (only this email can log in)
ALLOWED_EMAIL=

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:placeholder@example.com

# Apple Health auto-push (Shortcut sends Bearer <token>)
HEALTH_INGEST_TOKEN=

# Vercel cron auth for /api/cron/* (Vercel sends Bearer <CRON_SECRET>).
# Unset means the cron endpoints reject every request.
CRON_SECRET=
