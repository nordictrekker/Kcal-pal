# Copy to scripts/deploy.env and fill in. deploy.env is gitignored.
# Used by scripts/deploy-edge-functions.sh.

SB_SECRET_KEY=sb_secret_...        # Project Settings -> API -> Secret keys
ALLOWED_EMAIL=you@example.com

# Generate a fresh pair with `npx web-push generate-vapid-keys`. Rotating the
# pair invalidates existing push subscriptions — clients re-subscribe on next
# visit to /settings.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
